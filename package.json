    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "edge-tts-universal": "^1.4.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.15.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.0",
    "sherpa-onnx-node": "^2.0.3",
    "three": "^0.187.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
